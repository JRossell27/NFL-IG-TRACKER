# ================================================================
# NFL IG Tracker — Streamlit Secrets
#
# HOW TO USE:
#   Local dev:       copy this file to .streamlit/secrets.toml
#                    and fill in your values
#   Streamlit Cloud: paste these key=value pairs into
#                    App Settings → Secrets
# ================================================================

# ── Supabase (free at supabase.com) ──────────────────────────
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
# Use the SERVICE ROLE key (not the anon key) — found in
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_KEY = "eyJhbGci..."

# ── Instagram (throwaway account for scraping) ────────────────
INSTAGRAM_USERNAME = "your_throwaway_ig_username"
INSTAGRAM_PASSWORD = "your_throwaway_ig_password"

# ── X (Twitter) API — Free tier ───────────────────────────────
# Get these at developer.twitter.com → create an app
X_API_KEY              = "your_api_key"
X_API_KEY_SECRET       = "your_api_key_secret"
X_ACCESS_TOKEN         = "your_access_token"
X_ACCESS_TOKEN_SECRET  = "your_access_token_secret"

# ── Optional settings ─────────────────────────────────────────
MAX_X_POSTS_PER_DAY = "17"

# ── Streamlit keep-alive (paste your deployed app URL) ────────
STREAMLIT_APP_URL = "https://yourapp.streamlit.app"

# ── Admin panel password (protects the X post preview tool) ───
ADMIN_PASSWORD = "choose_a_strong_password_here"

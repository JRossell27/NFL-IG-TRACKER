# Instagram Credentials (required for tracking)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# X (Twitter) API Credentials - Free tier
# Get these at developer.twitter.com
X_API_KEY=your_x_api_key
X_API_KEY_SECRET=your_x_api_key_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret

# App Settings
FLASK_PORT=5000
FLASK_DEBUG=false

# Tracking Settings
# How often to check each player's following (in hours)
CHECK_INTERVAL_HOURS=6
# Max X posts per day (free tier allows ~50/month write = ~1-2/day, be conservative)
MAX_X_POSTS_PER_DAY=17
# Only post to X if the followed account has this many followers (0 = post all)
MIN_FOLLOWER_COUNT_TO_POST=0
